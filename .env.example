# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port the server listens on. Defaults to 3000, which often collides
# with another local project. Set it here if you run several apps at once.
PORT=3100

# GEMINI_MODEL: Overrides the default model without touching code.
# GET /api/ai/models lists candidate names for your key.
# GEMINI_MODEL=gemini-3.6-flash

# ── Form delivery ────────────────────────────────────────────────────────
# Every website submission is emailed via Web3Forms: contact, newsletter,
# syllabus requests, cohort applications, corporate advisory, and
# student/mentor registration.
#
# Get a key at https://web3forms.com - enter the address below, and they
# email you an access key. No account, no password, no domain setup.
#
# The key decides the destination: Web3Forms delivers to whichever address
# the key was created for and has no "to" override. Create the key using
# infoschoolofgrowth@gmail.com or submissions will land somewhere else.
#
# VITE_ prefixed and inlined into the browser bundle at BUILD time, because
# Web3Forms rejects server-side callers on the free plan and only accepts
# the request from the browser. Their access keys are public identifiers by
# design, not secrets - a key can only deliver to its registered address.
# It must be set wherever the site is BUILT, including Vercel.
VITE_WEB3FORMS_ACCESS_KEY="your-web3forms-access-key"

# ── Payments (Paystack) ──────────────────────────────────────────────────
# Course packages (Mini / Medium / Maxi) and mentorship subscriptions are
# charged through Paystack. Prices live in src/lib/pricing.ts, not here.
#
# Get both keys from the Paystack dashboard: Settings > API Keys & Webhooks.
# Use the test keys (sk_test_... / pk_test_...) until you are ready to take
# real money; test cards are listed at https://paystack.com/docs/payments/test-payments
#
# PAYSTACK_SECRET_KEY is a REAL secret - it can move money. It is read only on
# the server and is never sent to the browser. Never prefix it with VITE_, and
# never commit a live key.
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"

# Public/publishable key. Safe to expose; the browser fetches it from
# /api/payments/config rather than having it baked into the bundle.
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# Where Paystack returns the payer after checkout. Must be the absolute origin
# of the deployed site, e.g. https://schoolofgrowth.vercel.app - the app appends
# /payment/callback. Falls back to APP_URL, then to the request's own host,
# which is what makes local development work with no extra setup.
# PAYSTACK_CALLBACK_URL="https://your-domain.com"
#
# Also add the webhook URL in the Paystack dashboard so payments still register
# when a student closes the tab mid-redirect:
#   https://your-domain.com/api/payments/webhook

# ── Admin panel ──────────────────────────────────────────────────────────
# The admin dashboard at /admin is DISABLED until ADMIN_PASSWORD is set.
# There is no default password on purpose: a panel that unlocks with a value
# committed to the repo is worse than no panel at all.
#
# Use a long random value, not a memorable one - this is the only thing
# standing between the internet and your enrolment data. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=""

# Optional. Signs admin session tokens. If unset, the key is derived from
# ADMIN_PASSWORD instead, which means changing the password signs everyone
# out - usually what you want. Set this explicitly only if you need sessions
# to survive a password change.
# ADMIN_SESSION_SECRET=""

# Mentor inbox at /mentor/inbox. This is a shared access code until individual
# mentor accounts exist. Use a long random value and set it in Vercel too.
MENTOR_INBOX_PASSWORD=""

# Optional. Signs mentor inbox sessions. If unset, the app falls back to the
# admin session secret/password-derived key.
# MENTOR_INBOX_SESSION_SECRET=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
